{
  "name": "ai-optimized-usage-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "npm run check:types && npm run lint && npm run test && npm run check:links && npm run check:spell",
    "check:types": "astro check",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "check:links": "node scripts/check-links.mjs",
    "check:spell": "cspell --no-progress \"src/content/**/*.{md,mdx}\" \"src/data/*.json\" README.md",
    "test:e2e": "playwright test",
    "freshness": "node scripts/freshness.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.2",
    "@astrojs/react": "7.0.0",
    "@astrojs/starlight": "0.42.4",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@cspell/dict-es-es": "3.0.9",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cspell": "10.3.6",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
