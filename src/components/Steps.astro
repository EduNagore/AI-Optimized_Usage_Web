---
/**
 * Procedimiento numerado. Se usa donde el orden importa; para razonamientos, prosa. Envuelve una
 * lista ordenada de Markdown:
 *
 *   <Steps>
 *   1. Primer paso.
 *   2. Segundo paso.
 *   </Steps>
 */
---

<div class="steps">
  <slot />
</div>

<style>
  .steps {
    margin-block: var(--space-6);
  }
  .steps :global(ol) {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: paso;
  }
  .steps :global(ol > li) {
    position: relative;
    margin: 0;
    padding-inline-start: 2.75rem;
    padding-bottom: var(--space-5);
    counter-increment: paso;
  }
  .steps :global(ol > li:last-child) {
    padding-bottom: 0;
  }
  /* Número del paso */
  .steps :global(ol > li::before) {
    content: counter(paso);
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    border: var(--border-width) solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-accent-tint);
    color: var(--color-accent-strong);
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  /* Hilo que une los pasos */
  .steps :global(ol > li:not(:last-child)::after) {
    content: '';
    position: absolute;
    inset-block: 2.125rem 0.25rem;
    inset-inline-start: 0.9375rem;
    width: 1px;
    background: var(--color-border-strong);
  }
  .steps :global(ol > li > :first-child) {
    margin-top: 0.15rem;
  }
  .steps :global(ol > li > :last-child) {
    margin-bottom: 0;
  }
</style>
