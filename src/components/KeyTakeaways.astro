---
/** Bloque «En 30 segundos»: 3–5 ideas clave al principio de cada lección. Se pasa una lista MDX. */
interface Props {
  titulo?: string;
}
const { titulo = 'En 30 segundos' } = Astro.props;
---

<section class="takeaways" aria-labelledby="en-30-segundos">
  <h2 id="en-30-segundos" class="takeaways-title">
    {titulo}
  </h2>
  <div class="takeaways-body">
    <slot />
  </div>
</section>

<style>
  .takeaways {
    margin-block: var(--space-6);
    padding: var(--space-4) var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-inline-start: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .takeaways .takeaways-title {
    margin: 0 0 var(--space-2);
    color: var(--color-heading);
    font-size: var(--text-lg);
    line-height: 1.3;
  }
  .takeaways-body > :global(*:first-child) {
    margin-top: 0;
  }
  .takeaways-body > :global(*:last-child) {
    margin-bottom: 0;
  }
  .takeaways-body :global(ul) {
    padding-inline-start: 1.25rem;
  }
  .takeaways-body :global(li + li) {
    margin-top: var(--space-2);
  }
</style>
