---
import { splitVariables } from '@lib/diff';
import Icon from './Icon.astro';

/**
 * Plantilla de prompt con las variables {{así}} resaltadas, botón de copiar y descarga en .md.
 * Sin JavaScript se lee y se selecciona igual; los botones se activan al cargar la página.
 */
interface Props {
  titulo: string;
  /** Texto de la plantilla; las variables se escriben {{variable}}. */
  texto: string;
  /** Nombre del fichero descargado, sin extensión. Por defecto, el título normalizado. */
  archivo?: string;
}

const { titulo, texto, archivo } = Astro.props;
const parts = splitVariables(texto.trim());
const filename =
  archivo ??
  titulo
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
const hasUsage = Astro.slots.has('default');
---

<div
  class="prompt-template not-content"
  data-filename={filename}
  data-title={titulo}
  data-text={texto.trim()}
>
  <div class="head">
    <p class="title">{titulo}</p>
    <div class="actions" hidden data-actions>
      <button type="button" class="btn" data-copy>
        <Icon name="copiar" size={16} /> <span>Copiar</span>
      </button>
      <button type="button" class="btn" data-download>
        <Icon name="descargar" size={16} /> <span>Descargar .md</span>
      </button>
    </div>
  </div>
  {hasUsage && (
    <div class="usage">
      <slot />
    </div>
  )}
  <div class="text" tabindex="0" role="region" aria-label={`Texto de la plantilla: ${titulo}`}>
    {parts.map((p) => (p.variable ? <mark class="var">{p.text}</mark> : <Fragment>{p.text}</Fragment>))}
  </div>
  <p class="hint">Las partes resaltadas son variables: sustitúyelas por tus datos antes de enviar.</p>
  <p class="status" role="status" aria-live="polite" data-status></p>
</div>

<style>
  .prompt-template {
    margin-block: var(--space-6);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .title {
    font-weight: 600;
    margin: 0;
    color: var(--color-heading);
    font-size: var(--text-base);
    line-height: 1.3;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .actions[hidden] {
    display: none;
  }
  .usage {
    padding: var(--space-3) var(--space-4) 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .usage > :global(:first-child) {
    margin-top: 0;
  }
  .usage > :global(:last-child) {
    margin-bottom: 0;
  }
  .text {
    margin: var(--space-3) var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    font-size: var(--text-sm);
    line-height: 1.65;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .var {
    padding: 0 0.2em;
    border-bottom: 2px solid var(--color-accent);
    border-radius: 2px;
    background: var(--color-accent-tint);
    color: var(--color-accent-strong);
    font-weight: 600;
  }
  .hint {
    margin: 0 var(--space-4) var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }
  .status {
    min-height: 0;
    margin: 0 var(--space-4);
    color: var(--sem-verificado-fg);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .status:not(:empty) {
    margin-bottom: var(--space-3);
  }
</style>

<script>
  // Mejora progresiva: sin JS, la plantilla se lee y se copia a mano.
  function say(root: HTMLElement, message: string) {
    const status = root.querySelector<HTMLElement>('[data-status]');
    if (!status) return;
    status.textContent = message;
    window.setTimeout(() => {
      status.textContent = '';
    }, 2500);
  }

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // Sin permiso de portapapeles (o sin contexto seguro): el texto sigue siendo seleccionable.
      return false;
    }
  }

  document.querySelectorAll<HTMLElement>('.prompt-template').forEach((root) => {
    const text = root.dataset['text'] ?? '';
    const title = root.dataset['title'] ?? 'plantilla';
    const filename = root.dataset['filename'] || 'plantilla';
    root.querySelector<HTMLElement>('[data-actions]')?.removeAttribute('hidden');

    root.querySelector('[data-copy]')?.addEventListener('click', async () => {
      say(
        root,
        (await copyText(text))
          ? 'Copiado al portapapeles.'
          : 'No se pudo copiar: selecciona el texto a mano.',
      );
    });

    root.querySelector('[data-download]')?.addEventListener('click', () => {
      const body = text.startsWith('---') ? `${text}\n` : `# ${title}\n\n${text}\n`;
      const blob = new Blob([body], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `${filename}.md`;
      document.body.append(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      say(root, `Descargado ${filename}.md`);
    });
  });
</script>
