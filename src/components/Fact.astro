---
import { getCollection, getEntry } from 'astro:content';
import { resolveFact } from '@lib/facts';
import { formatDate } from '@lib/format';

/**
 * Dato volátil en línea, leído de src/data/models.json. Nunca se escribe a mano un precio, una
 * ventana de contexto o un identificador: se referencia. El tooltip (foco o ratón) muestra de qué
 * dato se trata, la fuente y la fecha de verificación.
 *
 *   <Fact id="opus-5-5.pricing.input" />        →  4 $
 *   <Fact id="opus-5-5.contextWindow" corto />  →  1 M
 */
interface Props {
  id: string;
  /** Ventanas de contexto abreviadas («1 M» en lugar de «1.000.000 tokens»). */
  corto?: boolean;
}

const { id, corto = false } = Astro.props;
const models = (await getCollection('models')).map((e) => e.data);
const fact = resolveFact(models, id, corto);
const source = await getEntry('sources', fact.source);
if (!source) throw new Error(`<Fact id="${id}">: la fuente «${fact.source}» no existe en sources.json`);
---

<!-- prettier-ignore -->
<span class="fact"><span class="fact-value" tabindex="0">{fact.display}</span><span class="fact-tip" role="tooltip"><strong>{fact.label}</strong>Fuente: {source.data.publisher}, {source.data.title}. Verificado el {formatDate(fact.verifiedAt)}.</span></span>

<style>
  .fact {
    position: relative;
    font-variant-numeric: tabular-nums;
  }
  .fact-value {
    border-bottom: 1px dotted var(--color-text-muted);
    color: var(--color-heading);
    font-weight: 600;
    white-space: nowrap;
    cursor: help;
  }
  .fact-tip {
    position: fixed;
    inset-inline: var(--space-4);
    inset-block-end: var(--space-4);
    z-index: 30;
    display: none;
    max-width: 26rem;
    margin-inline: auto;
    padding: var(--space-3) var(--space-4);
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: 1.45;
  }
  .fact-tip strong {
    display: block;
    margin-bottom: var(--space-1);
    color: var(--color-heading);
  }
  .fact:hover .fact-tip,
  .fact:focus-within .fact-tip {
    display: block;
  }
  @media print {
    .fact-tip {
      display: none !important;
    }
  }
</style>
