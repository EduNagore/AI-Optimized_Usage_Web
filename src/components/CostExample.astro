---
import { getCollection, getEntry } from 'astro:content';
import { formatDate } from '@lib/format';

/**
 * Coste de un intento y de un volumen, calculado desde models.json y el descuento de Batch de
 * pricing-rules.json. Así los resultados se actualizan solos cuando cambian los precios.
 * Los tokens de razonamiento se facturan como salida y no están incluidos: se suman a `salida`.
 */
interface Props {
  ids: string[];
  /** Tokens de entrada de un intento. */
  entrada: number;
  /** Tokens de salida de un intento (incluido el razonamiento, si lo hay). */
  salida: number;
  /** Número de documentos o ejecuciones del caso de volumen. */
  volumen: number;
  etiqueta?: string;
  /** Tokens de la entrada que se leen de la caché (caliente) en cada intento; añade una columna. */
  cacheados?: number;
  /** Muestra la columna «Con Batch». Por defecto, sí. */
  batch?: boolean;
  /** Unidad del volumen en el encabezado de la columna (por defecto, «documentos»). */
  unidad?: string;
}

const {
  ids,
  entrada,
  salida,
  volumen,
  etiqueta = 'Coste de un intento y de un volumen',
  cacheados,
  batch: mostrarBatch = true,
  unidad = 'documentos',
} = Astro.props;
const models = (await getCollection('models')).map((e) => e.data);
const rule = await getEntry('pricing-rules', 'anthropic-batch-discount');
if (!rule) throw new Error('<CostExample>: falta anthropic-batch-discount en pricing-rules.json');
const batch = rule.data.value;
if (typeof batch !== 'number') throw new Error('<CostExample>: el descuento de Batch no es numérico');

const rows = ids.map((id) => {
  const m = models.find((r) => r.id === id);
  if (!m) throw new Error(`<CostExample>: no existe el modelo «${id}»`);
  const perAttempt = (entrada * (m.pricing.input ?? 0) + salida * (m.pricing.output ?? 0)) / 1_000_000;
  const cached =
    cacheados === undefined
      ? undefined
      : (((entrada - cacheados) * (m.pricing.input ?? 0) +
          cacheados * (m.pricing.cacheRead ?? 0) +
          salida * (m.pricing.output ?? 0)) /
          1_000_000) *
        volumen;
  return { m, perAttempt, total: perAttempt * volumen, cached };
});
const fmt = (n: number) =>
  `${new Intl.NumberFormat('es-ES', {
    maximumFractionDigits: n < 0.01 ? 4 : n < 10 ? 3 : 0,
  }).format(n)} $`;
const num = (n: number) => new Intl.NumberFormat('es-ES').format(n);
const verified = rows
  .map((r) => r.m.verifiedAt)
  .sort()
  .at(-1)!;
const tiers = rows.flatMap((r) =>
  r.m.notes?.startsWith('Precios hasta') ? [`${r.m.name}: ${r.m.notes.split('. ')[0]}`] : [],
);
---

<div class="table-wrap not-content">
  <div class="scroller" role="region" aria-label={etiqueta} tabindex="0">
    <table>
      <caption class="sr-only">
        {etiqueta}:{num(entrada)}tokens de entrada y{num(salida)}de salida por intento.
      </caption>
      <thead>
        <tr>
          <th scope="col">Modelo</th>
          <th scope="col" class="num">
            Un intento
          </th>
          <th scope="col" class="num">
            {num(volumen)} {unidad}
          </th>
          {cacheados !== undefined && (
            <th scope="col" class="num">
              Con {num(cacheados)} tokens en caché
            </th>
          )}
          {mostrarBatch && (
            <th scope="col" class="num">
              Con Batch
            </th>
          )}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row">{r.m.name}</th>
            <td class="num">{fmt(r.perAttempt)}</td>
            <td class="num">{fmt(r.total)}</td>
            {r.cached !== undefined && <td class="num">{fmt(r.cached)}</td>}
            {mostrarBatch && <td class="num">{fmt(r.total * batch)}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    Cálculo con los precios de <code>models.json</code> verificados el {formatDate(verified)}.{' '}
    {mostrarBatch && `Batch aplica el factor ${batch} de pricing-rules.json. `}
    {cacheados !== undefined &&
      'La columna de caché supone la caché caliente en todos los intentos (lectura a precio de lectura de caché) y no incluye la primera escritura. '}
    {tiers.length > 0 && ` Tarifas por tramos: ${tiers.join('; ')}.`}
  </p>
</div>

<style>
  .table-wrap {
    margin-block: var(--space-5);
  }
  .scroller {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm, 0.9rem);
  }
  th,
  td {
    padding: var(--space-2) var(--space-3);
    text-align: left;
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }
  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  .note {
    margin-block: var(--space-2) 0;
    font-size: var(--text-sm, 0.9rem);
    color: var(--color-text-muted);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>
