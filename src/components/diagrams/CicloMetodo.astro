---
import { methodSteps } from '@lib/method';
import { url } from '@lib/paths';
import Diagram from '../Diagram.astro';

/**
 * Diagrama 1 (plan/03_DISENO.md §7): el ciclo del método en siete pasos. Dos dibujos del mismo
 * contenido: un anillo para pantallas anchas y una columna para móviles, de modo que el texto se
 * lee a tamaño real a 360 px. Cada paso enlaza a la lección que lo desarrolla.
 */
interface Props {
  id?: string;
}
const { id = 'ciclo-metodo' } = Astro.props;

// --- Anillo (ancho): elipse con los pasos en el sentido de las agujas del reloj ---
const W = 800;
const H = 425;
const cx = 400;
const cy = 240;
const rx = 170;
const ry = 150;
const R = 24; // radio de cada nodo
const rad = (deg: number) => (deg * Math.PI) / 180;
const point = (deg: number) => ({ x: cx + rx * Math.cos(rad(deg)), y: cy + ry * Math.sin(rad(deg)) });
const step = 360 / methodSteps.length;
const gap = 12; // grados que se dejan libres junto a cada nodo
const nodes = methodSteps.map((s, i) => {
  const deg = -90 + i * step;
  const p = point(deg);
  const right = Math.cos(rad(deg)) > 0.2;
  const left = Math.cos(rad(deg)) < -0.2;
  return {
    ...s,
    ...p,
    anchor: right ? 'start' : left ? 'end' : 'middle',
    lx: right ? p.x + R + 12 : left ? p.x - R - 12 : p.x,
    ly: right || left ? p.y + 6 : p.y - R - 14,
  };
});
const arcs = nodes.map((_, i) => {
  const a = point(-90 + i * step + gap);
  const b = point(-90 + (i + 1) * step - gap);
  return `M ${a.x.toFixed(1)} ${a.y.toFixed(1)} A ${rx} ${ry} 0 0 1 ${b.x.toFixed(1)} ${b.y.toFixed(1)}`;
});

// --- Columna (estrecho) ---
const rowH = 84;
const top = 36;
const colH = top + rowH * methodSteps.length - 4;
const loopX = 342;
const rows = methodSteps.map((s, i) => ({ ...s, y: top + i * rowH }));
const loopPath = `M ${loopX - 20} ${rows[6]!.y} H ${loopX} V ${rows[0]!.y} H ${loopX - 20}`;
---

<Diagram
  id={id}
  titulo="El ciclo del método en siete pasos"
  descripcion="Siete pasos en círculo: clasifica, elige la superficie, elige modelo y esfuerzo, prepara el contexto, formula el encargo, verifica y sistematiza y mide. El último alimenta al primero. Cada paso enlaza a su lección."
>
  <!-- Anillo -->
  <svg
    class="ring"
    viewBox={`50 0 ${W - 20} ${H}`}
    role="group"
    aria-label="Ciclo del método en siete pasos, dibujado como un anillo"
  >
    <defs>
      <marker
        id={`${id}-punta`}
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="8"
        markerHeight="8"
        orient="auto-start-reverse"
      >
        <path d="M 1 1 L 9 5 L 1 9 z" class="head" />
      </marker>
    </defs>
    {arcs.map((d) => (
      <path d={d} class="arc" marker-end={`url(#${id}-punta)`} />
    ))}
    <text x={cx} y={cy - 14} text-anchor="middle" class="center-title">
      El método
    </text>
    <text x={cx} y={cy + 10} text-anchor="middle" class="center-sub">
      en siete pasos
    </text>
    <text x={cx} y={cy + 36} text-anchor="middle" class="center-note">
      Lo que mides en el último
    </text>
    <text x={cx} y={cy + 54} text-anchor="middle" class="center-note">
      mejora el primero.
    </text>
    {nodes.map((n) => (
      <a href={url(n.href)} aria-label={`Paso ${n.n}: ${n.name}. Ir a la lección.`}>
        <circle cx={n.x} cy={n.y} r={R} class="node" />
        <text x={n.x} y={n.y + 7} text-anchor="middle" class="num">
          {n.n}
        </text>
        <text x={n.lx} y={n.ly} text-anchor={n.anchor} class="label">
          {n.short}
        </text>
      </a>
    ))}
  </svg>

  <!-- Columna -->
  <svg
    class="column"
    viewBox={`0 0 360 ${colH}`}
    role="group"
    aria-label="Ciclo del método en siete pasos, dibujado como una columna"
  >
    <defs>
      <marker
        id={`${id}-punta-col`}
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="8"
        markerHeight="8"
        orient="auto-start-reverse"
      >
        <path d="M 1 1 L 9 5 L 1 9 z" class="head" />
      </marker>
    </defs>
    {rows.slice(0, -1).map((r) => (
      <path d={`M 22 ${r.y + 24} V ${r.y + rowH - 26}`} class="arc" marker-end={`url(#${id}-punta-col)`} />
    ))}
    <path d={loopPath} class="arc" marker-end={`url(#${id}-punta-col)`} />
    <text x={loopX - 6} y={rows[6]!.y + 66} text-anchor="end" class="center-note">
      y vuelta al paso 1
    </text>
    {rows.map((r) => (
      <a href={url(r.href)} aria-label={`Paso ${r.n}: ${r.name}. Ir a la lección.`}>
        <circle cx="22" cy={r.y} r="20" class="node" />
        <text x="22" y={r.y + 6} text-anchor="middle" class="num">
          {r.n}
        </text>
        <text x="58" y={r.y - 2} class="label">
          {r.name}
        </text>
        <text x="58" y={r.y + 18} class="detail">
          {r.detail[0]}
        </text>
        <text x="58" y={r.y + 35} class="detail">
          {r.detail[1]}
        </text>
      </a>
    ))}
  </svg>

  <Fragment slot="texto">
    <ol>
      {methodSteps.map((s) => (
        <li>
          <a href={url(s.href)}>{s.name}</a>: {s.detail.join(' ')}.
        </li>
      ))}
    </ol>
    <p>Al terminar el séptimo paso se vuelve al primero: lo que mides alimenta la siguiente tarea.</p>
  </Fragment>
</Diagram>

<style>
  .ring {
    display: none;
  }
  @container (min-width: 520px) {
    .ring {
      display: block;
    }
    .column {
      display: none;
    }
  }
  .column {
    max-width: 26rem;
    margin-inline: auto;
  }
  .arc {
    fill: none;
    stroke: var(--color-text-muted);
    stroke-width: 1.5;
  }
  .head {
    fill: var(--color-text-muted);
  }
  .node {
    fill: var(--color-accent-tint);
    stroke: var(--color-accent);
    stroke-width: 2;
  }
  .num {
    fill: var(--color-accent-strong);
    font-size: 19px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .label {
    fill: var(--color-heading);
    font-size: 18px;
    font-weight: 600;
  }
  .detail {
    fill: var(--color-text-muted);
    font-size: 13.5px;
  }
  .center-title {
    fill: var(--color-heading);
    font-size: 24px;
    font-weight: 600;
  }
  .center-sub {
    fill: var(--color-text);
    font-size: 17px;
  }
  .center-note {
    fill: var(--color-text-muted);
    font-size: 15px;
  }
  a {
    cursor: pointer;
  }
  a:hover .node {
    fill: var(--color-accent);
  }
  a:hover .num {
    fill: var(--color-on-accent);
  }
  a:hover .label {
    text-decoration: underline;
  }
  a:focus-visible {
    outline: none;
  }
  a:focus-visible .node {
    stroke: var(--color-accent-strong);
    stroke-width: 4;
  }
  a:focus-visible .label {
    text-decoration: underline;
  }
</style>
