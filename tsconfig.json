{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "src", "tests", "scripts", "e2e", "*.ts"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": { "@components/*": ["./src/components/*"], "@lib/*": ["./src/lib/*"] },
    "allowJs": true,
    "checkJs": false
  }
}
